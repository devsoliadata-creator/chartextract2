# Copy to .env and fill in. Keep .env private.
# main.py prefers this file over stale shell values.

FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project-name>

FOUNDRY_AUTH_MODE=entra

# Foundry identity: these NAME/VERSION pairs are the sole runtime source.
# The workflow derives each setting's key from agentNN_<step>; YAML has no fallback.
# NAME is the saved Foundry agent name. VERSION is its immutable version,
# not a model version. Create and pin agent versions in Microsoft Foundry.

# Agent 00: discovery
FOUNDRY_AGENT_00_NAME=agent00-discovery
FOUNDRY_AGENT_00_VERSION=

# Agent 01: chart structure
FOUNDRY_AGENT_01_NAME=agent01-structure
FOUNDRY_AGENT_01_VERSION=

# Agent 02: structure/calibration review
FOUNDRY_AGENT_02_NAME=agent02-calibration
FOUNDRY_AGENT_02_VERSION=

# Agent 03: point extraction/review
FOUNDRY_AGENT_03_NAME=agent03-extraction
FOUNDRY_AGENT_03_VERSION=

# Agent 04: independent final extraction/QA
FOUNDRY_AGENT_04_NAME=agent04-qa
FOUNDRY_AGENT_04_VERSION=


# Where the review page's corrections are saved (default: artifacts/reviews).
CHART_EXTRACT_REVIEWS_DIR=

# 1 = answer every agent step with its examples/<step>.example.json (no Azure calls; wiring/preview only).
CHART_EXTRACT_DRY_RUN=0
