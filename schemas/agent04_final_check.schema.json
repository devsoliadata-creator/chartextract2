{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent04_final_check_response",
  "description": "Agent 04 QA report accompanying its authoritative complete marker-inventory CSV. The host enforces explicit deletion of candidate IDs and one omission-correction attempt; this is not a response format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reasoning",
    "axis_check",
    "source_review",
    "verdict",
    "series",
    "uncertainties",
    "row_count",
    "points_csv",
    "points_csv_sha256",
    "calibration",
    "unresolved_slots",
    "changes"
  ],
  "properties": {
    "reasoning": {
      "type": "string"
    },
    "axis_check": {
      "$ref": "shared.schema.json#/$defs/axis_check"
    },
    "source_review": {
      "description": "Final native-source checks made after loading the Agent 03 candidate and review report.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_axis",
        "y_axis",
        "series",
        "visual_risks"
      ],
      "properties": {
        "x_axis": {
          "type": "string"
        },
        "y_axis": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "marker",
              "marker_fill",
              "visible_markers_estimate",
              "notes"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "marker": {
                "$ref": "shared.schema.json#/$defs/marker"
              },
              "marker_fill": {
                "$ref": "shared.schema.json#/$defs/marker_fill"
              },
              "visible_markers_estimate": {
                "type": "integer",
                "minimum": 0
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "visual_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "$ref": "shared.schema.json#/$defs/verdict"
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "shared.schema.json#/$defs/series_coverage"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "points_csv_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the UTF-8 bytes in points_csv, computed after the final inline CSV is assembled."
    },
    "points_csv": {
      "type": "string",
      "minLength": 1,
      "description": "Complete authoritative points.csv content, including the canonical header, returned inline rather than as a container file."
    },
    "calibration": {
      "type": "object",
      "required": [
        "axis_models",
        "frame_px"
      ],
      "description": "Full final calibration in the candidate JSON format; check or correct native tick anchors."
    },
    "unresolved_slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "by_series",
        "slots"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_series": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "series_label",
              "reason"
            ],
            "properties": {
              "series_label": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "point_id",
          "reason",
          "source_evidence"
        ],
        "properties": {
          "action": {
            "enum": [
              "add",
              "move",
              "delete",
              "reassign"
            ]
          },
          "point_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
